generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum Role { SUPER_ADMIN HR_MANAGER HR_EXECUTIVE RECRUITER PAYROLL AUDITOR MANAGER EMPLOYEE }
enum EmploymentStatus { ACTIVE PROBATION NOTICE EXITED INACTIVE }
enum CandidateStatus { APPLIED SCREENING SHORTLISTED INTERVIEW SELECTED OFFERED JOINED REJECTED WITHDRAWN }
enum ApprovalStatus { PENDING APPROVED REJECTED CANCELLED }
enum AttendanceStatus { PRESENT ABSENT HALF_DAY LATE WEEK_OFF HOLIDAY ON_LEAVE }
enum LeaveStatus { PENDING APPROVED REJECTED CANCELLED }
enum PayrollStatus { DRAFT PROCESSING PENDING_APPROVAL APPROVED PAID LOCKED }
model User {\n  agentRuns AgentRun[]\n  id String @id @default(cuid()); email String @unique; name String; passwordHash String; role Role @default(EMPLOYEE); active Boolean @default(true); employee Employee?; auditLogs AuditLog[]; approvals ApprovalRequest[] @relation("Approver"); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Employee {
  skills EmployeeSkill[]
  goals Goal[]
  checkIns PerformanceCheckIn[]
  learningPlans LearningPlan[]
  pulseResponses PulseResponse[]
  riskSignals RiskSignal[]\n  id String @id @default(cuid()); employeeCode String @unique; firstName String; lastName String?; email String? @unique; phone String?; department String; designation String; location String; joiningDate DateTime; probationEnd DateTime?; status EmploymentStatus @default(PROBATION); managerId String?; manager Employee? @relation("EmployeeManager",fields:[managerId],references:[id]); reports Employee[] @relation("EmployeeManager"); user User? @relation(fields:[userId],references:[id]); userId String? @unique; applications Application[]; attendances Attendance[]; leaveRequests LeaveRequest[]; payrollItems PayrollItem[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Job {
  skillRequirements JobSkill[]\n  id String @id @default(cuid()); title String; department String; location String; description String; openings Int @default(1); active Boolean @default(true); applications Application[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Candidate {
  candidateSkills CandidateSkill[]
  interviewKits InterviewKit[]\n  id String @id @default(cuid()); name String; email String?; phone String?; resumeUrl String?; skills String?; experience Float?; source String?; status CandidateStatus @default(APPLIED); applications Application[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Application { id String @id @default(cuid()); jobId String; candidateId String; employeeId String?; status CandidateStatus @default(APPLIED); score Float?; notes String?; job Job @relation(fields:[jobId],references:[id]); candidate Candidate @relation(fields:[candidateId],references:[id]); employee Employee? @relation(fields:[employeeId],references:[id]); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@unique([jobId,candidateId]) }
model Attendance { id String @id @default(cuid()); employeeId String; date DateTime; status AttendanceStatus; inTime DateTime?; outTime DateTime?; workedMinutes Int?; overtimeMinutes Int?; remarks String?; employee Employee @relation(fields:[employeeId],references:[id]); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@unique([employeeId,date]) }
model LeaveType { id String @id @default(cuid()); name String @unique; code String @unique; annualQuota Float @default(0); active Boolean @default(true); requests LeaveRequest[] }
model LeaveRequest { id String @id @default(cuid()); employeeId String; leaveTypeId String; fromDate DateTime; toDate DateTime; days Float; reason String?; status LeaveStatus @default(PENDING); approvedBy String?; employee Employee @relation(fields:[employeeId],references:[id]); leaveType LeaveType @relation(fields:[leaveTypeId],references:[id]); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model PayrollPeriod { id String @id @default(cuid()); year Int; month Int; status PayrollStatus @default(DRAFT); approvedAt DateTime?; paidAt DateTime?; items PayrollItem[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@unique([year,month]) }
model PayrollItem { id String @id @default(cuid()); periodId String; employeeId String; basic Decimal @db.Decimal(12,2); gross Decimal @db.Decimal(12,2); deductions Decimal @db.Decimal(12,2); net Decimal @db.Decimal(12,2); overtimeAmount Decimal @db.Decimal(12,2) @default(0); status PayrollStatus @default(DRAFT); period PayrollPeriod @relation(fields:[periodId],references:[id]); employee Employee @relation(fields:[employeeId],references:[id]); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@unique([periodId,employeeId]) }
model ComplianceRecord { id String @id @default(cuid()); period String; category String; dueDate DateTime?; status String @default("PENDING"); reference String?; notes String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model ApprovalRequest { id String @id @default(cuid()); action String; entityType String; entityId String; requestedBy String; approverId String?; status ApprovalStatus @default(PENDING); reason String?; decisionNote String?; requestedAt DateTime @default(now()); decidedAt DateTime?; approver User? @relation("Approver",fields:[approverId],references:[id]) }
model AuditLog { id String @id @default(cuid()); userId String?; action String; entityType String; entityId String?; metadata Json?; createdAt DateTime @default(now()); user User? @relation(fields:[userId],references:[id]) }

model Agent {
  id String @id @default(cuid())
  key String @unique
  name String
  description String
  category String
  enabled Boolean @default(true)
  requiresApproval Boolean @default(true)
  runs AgentRun[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model AgentRun {
  id String @id @default(cuid())
  agentId String
  requestedBy String
  input Json?
  output Json?
  status String @default("QUEUED")
  riskLevel String @default("LOW")
  createdAt DateTime @default(now())
  completedAt DateTime?
  agent Agent @relation(fields:[agentId],references:[id])
  requester User @relation(fields:[requestedBy],references:[id])
}
model Skill {
  id String @id @default(cuid())
  name String @unique
  category String
  description String?
  employees EmployeeSkill[]
  jobRequirements JobSkill[]
  candidateSkills CandidateSkill[]
  createdAt DateTime @default(now())
}
model EmployeeSkill {
  id String @id @default(cuid())
  employeeId String
  skillId String
  level Int @default(1)
  verified Boolean @default(false)
  lastAssessedAt DateTime?
  employee Employee @relation(fields:[employeeId],references:[id])
  skill Skill @relation(fields:[skillId],references:[id])
  @@unique([employeeId,skillId])
}
model JobSkill {
  id String @id @default(cuid())
  jobId String
  skillId String
  requiredLevel Int @default(1)
  weight Float @default(1)
  job Job @relation(fields:[jobId],references:[id])
  skill Skill @relation(fields:[skillId],references:[id])
  @@unique([jobId,skillId])
}
model CandidateSkill {
  id String @id @default(cuid())
  candidateId String
  skillId String
  level Int @default(1)
  confidence Float @default(0)
  candidate Candidate @relation(fields:[candidateId],references:[id])
  skill Skill @relation(fields:[skillId],references:[id])
  @@unique([candidateId,skillId])
}
model Goal {
  id String @id @default(cuid())
  employeeId String
  title String
  description String?
  target String?
  progress Float @default(0)
  status String @default("DRAFT")
  dueDate DateTime?
  employee Employee @relation(fields:[employeeId],references:[id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model PerformanceCheckIn {
  id String @id @default(cuid())
  employeeId String
  summary String?
  managerFeedback String?
  employeeReflection String?
  score Float?
  createdAt DateTime @default(now())
  employee Employee @relation(fields:[employeeId],references:[id])
}
model LearningPlan {
  id String @id @default(cuid())
  employeeId String
  title String
  skillGap String
  recommendedAction String
  status String @default("PLANNED")
  dueDate DateTime?
  employee Employee @relation(fields:[employeeId],references:[id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model PulseSurvey {
  id String @id @default(cuid())
  title String
  question String
  status String @default("OPEN")
  opensAt DateTime @default(now())
  closesAt DateTime?
  responses PulseResponse[]
  createdAt DateTime @default(now())
}
model PulseResponse {
  id String @id @default(cuid())
  surveyId String
  employeeId String
  score Int
  comment String?
  survey PulseSurvey @relation(fields:[surveyId],references:[id])
  employee Employee @relation(fields:[employeeId],references:[id])
  createdAt DateTime @default(now())
  @@unique([surveyId,employeeId])
}
model RiskSignal {
  id String @id @default(cuid())
  employeeId String
  type String
  score Float
  severity String
  explanation String
  resolved Boolean @default(false)
  employee Employee @relation(fields:[employeeId],references:[id])
  createdAt DateTime @default(now())
}
model InterviewKit {
  id String @id @default(cuid())
  candidateId String
  role String
  questions Json
  rubric Json
  candidate Candidate @relation(fields:[candidateId],references:[id])
  createdAt DateTime @default(now())
}
